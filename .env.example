# Kopyalayın: cp .env.example .env
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-anahtar-yazin
JWT_EXPIRE_MINUTES=60
TIMEZONE=Europe/Istanbul
CORS_ORIGINS=["http://localhost:3000"]

# İsteğe bağlı: openFDA API anahtarı (anahtarsız da çalışır, günlük limit düşüktür)
OPENFDA_API_KEY=

# M4: LLM koç (Claude tool-use) — anahtar boşsa kural tabanlı koç ve şablon özet kullanılır
ANTHROPIC_API_KEY=
# auto: anahtar varsa Claude | rule: daima kural tabanlı (LLM'e hiç veri gitmez)
COACH_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
# Düşünme derinliği/maliyet: low|medium|high (Haiku 4.5 kullanılırsa boş bırakın)
LLM_EFFORT=low
# Yanıt başına token üst sınırı ve tool-use döngüsündeki en fazla model çağrısı
LLM_MAX_TOKENS=2048
LLM_MAX_TOOL_ITERATIONS=4
LLM_TIMEOUT_SECONDS=30
# Güvenlik reddinde sunucu tarafı yedek model (yalnızca Claude API; Bedrock/Vertex'te false yapın)
LLM_SERVER_FALLBACKS=true
# Maliyet limitleri — aşılınca kural tabanlı koç (guardrail_action=budget_exceeded) / şablon özet
LLM_DAILY_PATIENT_REQUESTS=30
LLM_DAILY_PATIENT_TOKENS=300000
LLM_DAILY_SUMMARY_REQUESTS=3
LLM_MONTHLY_BUDGET_USD=50

# M4: RAG (eğitim içeriği araması) — local: çevrimdışı deterministik gömme | voyage: Voyage AI API
EMBEDDING_PROVIDER=local
VOYAGE_API_KEY=
# Bu benzerlik skorunun altındaki sonuçlar kaynak olarak kullanılmaz
RAG_MIN_SCORE=0.25
# openFDA etiket önbelleği (docker compose bunu otomatik ayarlar; boşsa süreç içi önbellek)
REDIS_URL=

# M3: Web push (VAPID) — `npx web-push generate-vapid-keys` ile üretin
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
