# İlaç Koçu API önündeki ters vekil ve yük dengeleyici (nginx >= 1.27.3: upstream "resolve").
# nginx resmi imajı bu şablonu açılışta envsubst ile /etc/nginx/conf.d/default.conf'a yazar
# (değişkenler: NGINX_RATE_LIMIT, NGINX_RATE_BURST). Bu dosya nginx'in http {} bloğu içine eklenir.

# Docker'ın gömülü DNS'i: "api" adı her kopyanın IP'sine çözülür; kopya değişince 10 sn'de yenilenir
resolver 127.0.0.11 valid=10s ipv6=off;

upstream api_backend {
    zone api_backend 64k;
    least_conn;                                   # en az açık bağlantılı kopyaya
    server api:8000 resolve max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# Gerçek istemci IP'si: yalnızca Docker iç ağından (web konteyneri) gelen X-Forwarded-For'a güvenilir
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 192.168.0.0/16;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# Kaba IP başına sınır (kötüye kullanım/DoS); kullanıcı başına ince sınır API'deki token bucket'tadır
limit_req_zone $binary_remote_addr zone=api_per_ip:10m rate=${NGINX_RATE_LIMIT};
limit_req_status 429;
limit_req_log_level warn;

# İstek kimliği: gelen X-Request-ID varsa korunur, yoksa nginx üretir (API loglarıyla eşleşir)
map $http_x_request_id $req_id {
    default $http_x_request_id;
    ""      $request_id;
}

# Erişim logu: sorgu dizesi ($args) ve gövde YAZILMAZ (sağlık verisi/ilaç adı içerebilir)
log_format api_json escape=json '{"time":"$time_iso8601","request_id":"$req_id","method":"$request_method",'
    '"path":"$uri","status":$status,"duration_s":$request_time,"upstream":"$upstream_addr",'
    '"upstream_s":"$upstream_response_time"}';

gzip on;
gzip_proxied any;
gzip_min_length 1024;
gzip_types application/json text/plain text/css application/javascript;
gzip_vary on;

server_tokens off;

server {
    listen 8080;
    client_max_body_size 1m;
    access_log /dev/stdout api_json;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Prometheus metrikleri kopyalardan iç ağda doğrudan toplanır; dışarıya açılmaz
    location = /metrics {
        return 404;
    }

    # Swagger / ReDoc: CDN'den script yükler, katı CSP uygulanmaz
    location ~ ^/(docs|redoc|openapi\.json)$ {
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
    }

    location / {
        limit_req zone=api_per_ip burst=${NGINX_RATE_BURST} nodelay;
        include /etc/nginx/snippets/proxy.conf;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
    }
}
